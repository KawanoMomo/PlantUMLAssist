!procedure AwsPart($alias, $label, $tech, $stereo)
rectangle "<$Doc>\n$label\n[$tech]" <<$stereo>> as $alias
!endprocedure

actor "Person" as personAlias
AwsPart(desktopAlias, "Desktop", "WorkDocs", "WorkDocs")
AwsPart(storageAlias, "Storage", "S3", "SimpleStorageService")

personAlias --> desktopAlias
desktopAlias --> storageAlias
@enduml
