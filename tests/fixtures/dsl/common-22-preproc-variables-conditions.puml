' 狙い: !$var 代入、!if/!elseif/!else、!while、組み込み関数 %strlen %upper %substr、%true/%false
@startuml
!$mode = "prod"
!$count = 3
!$i = 1
!if ($mode == "dev")
  !$label = "開発"
!elseif ($mode == "prod")
  !$label = "本番"
!else
  !$label = "不明"
!endif
title 環境: $label / 名前長=%strlen("PlantUML") / %upper("abc")
!while $i <= $count
  participant "サービス$i" as S$i
  !$i = $i + 1
!endwhile
S1 -> S2 : %substr("ABCDEFG", 1, 3)
S2 -> S3 : 転送
!if %true()
S3 --> S1 : 完了
!endif
@enduml
